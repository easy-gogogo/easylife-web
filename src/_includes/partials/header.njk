{# Kopfzeile + Menü – für ALLE Seiten und Sprachen nur hier bearbeiten #}
{% from "partials/icons.njk" import icon %}
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="{{ 'home' | link }}" aria-label="EasyLife Hoi An – Home">
      <img src="/images/brand/logos/easylife-hoian-logo-dark.png" alt="EasyLife Hoi An" width="120" height="56">
    </a>
    <nav class="mainnav" aria-label="Main">
      <div class="navmenu">
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list">{{ icon("menu") }}<span>{{ "nav.menu" | t }}</span></button>
        <ul id="nav-list">
          <li class="has-sub"><span class="navlabel">{{ "nav.stay" | t }}</span>
            <ul>
              <li><a href="{{ 'villa' | link }}">{{ "nav.villa" | t }}</a></li>
              <li><a href="{{ 'hostel' | link }}">{{ "nav.hostel" | t }}</a></li>
            </ul>
          </li>
          <li><a href="{{ 'rentals' | link }}">{{ "nav.rentals" | t }}</a></li>
          <li><a href="{{ 'activities' | link }}">{{ "nav.activities" | t }}</a></li>
          <li><a href="{{ 'transport' | link }}">{{ "nav.transport" | t }}</a></li>
          <li><a href="{{ 'tips' | link }}">{{ "nav.tips" | t }}</a></li>
          <li><a href="{{ 'about' | link }}">{{ "nav.about" | t }}</a></li>
        </ul>
      </div>
    </nav>
    <div class="topbar-right">
      <details class="lang">
        <summary aria-label="{{ 'nav.language' | t }}">{{ icon("globe", 18) }}<span>{{ (languages | find("code", lang)).short }}</span></summary>
        <ul>
          {% for l in languages %}{% if l.live and routes[pageKey][l.code] %}
          <li><a href="{{ pageKey | link(l.code) }}?lang={{ l.code }}" hreflang="{{ l.hreflang or l.code }}" lang="{{ l.hreflang or l.code }}"{% if l.code == lang %} aria-current="true"{% endif %}>{{ l.name }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </details>
      <a class="nav-cta" href="{{ site.whatsapp }}" target="_blank" rel="noopener">{{ icon("whatsapp", 18) }}<span>{{ "nav.ask" | t }}</span></a>
    </div>
  </div>
</header>
