{# Angebotskarte (Aktivität / Transfer). Erwartet: o = {id,title,price,meta[],short,images[],full,link}, askLabel, moreLabel, detailsLabel #}
{% from "partials/icons.njk" import icon %}
<article class="card offer" id="{{ o.id }}">
  <div class="card-img{% if o.images.length > 1 %} carousel{% endif %}">
    <div class="carousel-track">
      {% for img in o.images %}<img src="{{ img }}" alt="{{ o.title }}{% if o.images.length > 1 %} – {{ loop.index }}/{{ o.images.length }}{% endif %}" loading="lazy" width="800" height="600">{% endfor %}
    </div>
    {% if o.images.length > 1 %}
    <button class="car-btn prev" type="button" aria-label="‹">‹</button>
    <button class="car-btn next" type="button" aria-label="›">›</button>
    <span class="car-dots" aria-hidden="true">{% for img in o.images %}<i></i>{% endfor %}</span>
    {% endif %}
  </div>
  <div class="card-body">
    <div class="card-top"><h3 class="card-title">{{ o.title }}</h3>{% if o.price %}<span class="price-tag">{{ o.price }}</span>{% endif %}</div>
    {% if o.meta.length %}<div class="card-meta">{{ o.meta | join(" · ") }}</div>{% endif %}
    <div class="card-desc">{{ o.short | safe }}</div>
    {% if o.full %}<details class="more"><summary>{{ moreLabel }}</summary><div class="more-body">{{ o.full | safe }}</div></details>{% endif %}
    <div class="card-footer{% if not o.link %} one{% endif %}">
      <a class="book-btn" href="{{ (('ui' | cx).cta.waHello + ' ' + o.title) | wa }}" target="_blank" rel="noopener">{{ icon("whatsapp", 18) }} {{ askLabel }}</a>
      {% if o.link %}<a class="more-btn" href="{{ o.link | link }}">{{ detailsLabel }}</a>{% endif %}
    </div>
  </div>
</article>
