---
layout: base.njk
---
{# Layout für Reisetipps-Artikel #}
{% from "partials/icons.njk" import icon %}
{% set u = "ui" | cx %}
{% set hero = { eyebrow: kicker, title: title, lead: description, image: image, alt: imageAlt } %}
{% set crumbs = [["tips", u.nav.tips], [pageKey, title]] %}
{% include "partials/page-hero.njk" %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "Article", "headline": title, "description": description,
  "image": "https://easylifevietnam.com" + image, "inLanguage": lang, "datePublished": date | isoDate, "dateModified": (updated or date) | isoDate,
  "author": [{"@type":"Person","name":"Lan"},{"@type":"Person","name":"Martin"}],
  "publisher": { "@id": "https://easylifevietnam.com/#org" }, "mainEntityOfPage": pageKey | abs(lang)
} | json | safe }}</script>
<section class="section">
  <div class="wrap article-grid">
    <article class="prose">
      {{ content | safe }}
    </article>
    <aside class="article-aside">
      <div class="info-box">
        <h2 class="f-h dark">{{ u.common.related }}</h2>
        <ul class="aside-links">
          {% for key in related %}{% set rp = ("rentals" | cx).products[key] %}
          <li><a href="{{ key | link(lang if routes[key][lang] else 'en') }}">{{ icon("arrow", 16) }} {{ rp.name if rp else (u.nav[key] or key) }}</a></li>
          {% endfor %}
        </ul>
        <a class="book-btn full" href="{{ (u.cta.waHello + ' ' + title) | wa }}" target="_blank" rel="noopener">{{ icon("whatsapp", 18) }} {{ u.nav.ask }}</a>
      </div>
    </aside>
  </div>
</section>
{% include "partials/upsell.njk" %}
{% set rel = articles | where("lang", lang) | rejectattr("key", "equalto", tipKey) %}
{% if rel.length %}
<section class="section cream">
  <div class="wrap">
    <div class="cat-head"><h2>{{ u.nav.tips }}</h2></div>
    {% set list = rel %}{% include "partials/tip-cards.njk" %}
  </div>
</section>
{% endif %}
